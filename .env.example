# ==========================================================
# EduPath AI - Backend Proxy Environment Variables
# ==========================================================
# Port on which the Express proxy backend will run
PORT=5000

# Local Ollama AI Configuration
# Default Ollama local REST endpoint
OLLAMA_BASE_URL=http://localhost:11434
# Selected local model (e.g. phi4-mini:latest, llama3, mistral)
OLLAMA_MODEL=phi4-mini:latest

# YouTube Data API v3 Key
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> Create API Key
# Make sure to enable "YouTube Data API v3" for your GCP project
YOUTUBE_API_KEY=your_youtube_api_key_here

# Coursera Partner / Catalog API Key
# Get from: Coursera Developer Portal or Enterprise admin console
COURSERA_API_KEY=your_coursera_api_key_here

# Udemy Affiliate / Instructor API Credentials
# Get from: Udemy -> Account -> API Integration (Affiliate / Instructor account)
UDEMY_CLIENT_ID=your_udemy_client_id_here
UDEMY_CLIENT_SECRET=your_udemy_client_secret_here

# Optional: Default Search Skill if none specified
DEFAULT_SKILL=Full Stack AI Engineering
